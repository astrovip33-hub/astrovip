/
  Cache-Control: public, max-age=0, must-revalidate
  X-AstroVip-Release: 20260927-chatrestore1

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-AstroVip-Release: 20260927-chatrestore1

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN

# Top-level mutable assets: refresh in at most an hour.
# Placeholders do not match slashes, so these rules do not overlap.
/assets/:file
  Cache-Control: public, max-age=3600, must-revalidate

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/optimized-20261003/*
  Cache-Control: public, max-age=31536000, immutable

# no-store takes precedence over the general top-level asset policy.
/assets/site-editor-config.json
  Cache-Control: no-store

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/robots.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/sitemap*.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/atlas/*
  X-Robots-Tag: noindex, follow

/academia-astrologie/atlas-10000/*
  X-Robots-Tag: noindex, follow
